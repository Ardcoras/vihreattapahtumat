<header class="site-header" role="banner">
  <div class="site-header__inner">
    <div class="site-header__branding">
      {{ page.header }}
      <a href="{{ path('<front>') }}" class="site-header__subbrand">
        <span class="site-header__slash">/</span>
        <span class="site-header__label">Tapahtumakalenteri</span>
      </a>
    </div>

    <nav class="site-header__nav" aria-label="{{ 'Site navigation'|t }}">
      <button class="site-header__nav-toggle" aria-expanded="false" aria-controls="site-nav-links" aria-label="{{ 'Toggle navigation'|t }}">
        <span></span>
        <span></span>
        <span></span>
      </button>
      <div class="site-header__nav-links" id="site-nav-links">
        {{ page.primary_menu }}
        {% if page.primary_menu and page.secondary_menu %}
          <div class="site-header__nav-separator" aria-hidden="true"></div>
        {% endif %}
        <div class="site-header__account-link">
          {% if header_account.is_authenticated %}
            <details class="site-header__account-menu">
              <summary class="site-header__account-summary">
                <span class="site-header__account-name">{{ header_account.name }}</span>
              </summary>
              <div class="site-header__account-dropdown">
                <a href="{{ header_account.profile_url }}">{{ 'Profile'|t }}</a>
                <a href="{{ header_account.logout_url }}">{{ 'Log out'|t }}</a>
              </div>
            </details>
          {% else %}
            <a class="site-header__login-link" href="{{ header_account.login_url }}">{{ 'Log in'|t }}</a>
          {% endif %}
        </div>
      </div>
    </nav>
  </div>
</header>

<main role="main">
  <a id="main-content" tabindex="-1"></a>

  {% if page.highlighted %}
    <div class="region-highlighted">
      <div class="layout-container">
        {{ page.highlighted }}
      </div>
    </div>
  {% endif %}

  <div class="layout-container">
    {% if page.breadcrumb %}
      <div class="breadcrumb">
        {{ page.breadcrumb }}
      </div>
    {% endif %}

    {{ page.content }}
  </div>
</main>

{% if page.footer %}
  <footer class="site-footer" role="contentinfo">
    <div class="layout-container">
      {{ page.footer }}
    </div>
  </footer>
{% endif %}
